# ==============================================================================
# The Last Purnima — Fish Audio Pipeline Configuration
# ==============================================================================
# Copy this file to .env and fill in your Fish Audio credentials.
# NEVER commit your actual .env file or API keys to Git.

# Your Fish Audio API Key (from https://fish.audio/ or developer portal)
FISH_AUDIO_API_KEY=your_fish_audio_api_key_here

# Model to use:
# - s2.1-pro      (High fidelity, full emotion tags, standard tier)
# - s2.1-pro-free (Developer free tier)
# - s2-pro        (High fidelity S2 model)
# Default: s2.1-pro
FISH_AUDIO_MODEL=s2.1-pro

# ==============================================================================
# Character Voice IDs (reference_id)
# ==============================================================================
# Provide the voice model IDs (reference_id) for each character in the story.
# You can find these IDs in your Fish Audio voice library or custom voice models.

# Meera: Young woman, fearful, emotional, hostage
FISH_AUDIO_VOICE_MEERA=your_meera_voice_id_here

# The Keeper: Gritty, menacing, impatient thug
FISH_AUDIO_VOICE_KEEPER=your_keeper_voice_id_here

# Kabir / Protagonist: Determined, analytical family member
FISH_AUDIO_VOICE_PROTAGONIST=your_protagonist_voice_id_here

# Narrator: Atmospheric, cinematic Indian gothic mystery tone
FISH_AUDIO_VOICE_NARRATOR=your_narrator_voice_id_here
